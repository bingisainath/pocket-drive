# Backend configuration. `npm run hash-password` creates backend/.env from this file for you.

PORT=3000
# 127.0.0.1 = reachable only through `tailscale serve` / `tailscale funnel` (recommended: they add HTTPS).
# 0.0.0.0 also exposes it on your Wi-Fi LAN over plain HTTP.
HOST=127.0.0.1

# Where everything lives: files in $DATA_DIR/files, plus the SQLite index and thumbnail cache.
DATA_DIR=~/cloud-storage
# Optional: keep the files themselves elsewhere, e.g. Android shared storage so they're visible
# in the phone's Files app (requires `termux-setup-storage`; path depends on your proot setup).
# STORAGE_DIR=/sdcard/CloudDrive

# Per-file upload limit, and how much free space must always be left on the device.
MAX_UPLOAD_MB=4096
MIN_FREE_MB=500

SESSION_DAYS=30
# Failed logins allowed per client IP within the window before it's locked out for the rest of it.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# scrypt hash of the owner's backup password, generated by `npm run hash-password`. Never the plain password.
PASSWORD_HASH=

# --- Accounts & sharing ---
# Your Google account email: signing in with it makes you the owner (admin).
OWNER_EMAIL=
# Addresses where "Sign in with Google" is offered, comma-separated. Each needs a matching
# "Authorized redirect URI" of <origin>/api/auth/google/callback in your Google OAuth client.
# Example: PUBLIC_ORIGINS=https://tailscale-termux.tail790102.ts.net:8443,http://localhost:3000
PUBLIC_ORIGINS=
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID (type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# How long to keep the activity log (0 = forever).
ACTIVITY_RETENTION_DAYS=180
